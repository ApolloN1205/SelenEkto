# Python local environments and generated caches
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/*.py[cod]
**/*.egg-info/

# Generated application builds and local packaging
**/dist/
**/build/
**/release_ready/
**/_archive/
*.spec

# Raw NASA rasters, transient analysis, local settings and logs
**/data/raw/
**/data/cache/
**/data/processed/
**/data/config/desktop_settings.json
**/data/catalog/region_profiles/local_raster_inventory.json
**/data/catalog/named_candidates.before_*.json

# Local-only backups, temporary downloads and secrets
**/.local_backups/
**/*_backup_*/
**/*_backup.py
**/*_before_*.py
**/*_pre_*.py
*.bak
*.part
*.tmp
*.log
.env
.env.*
!.env.example
